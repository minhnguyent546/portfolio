{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Prettier's extension has no built-in `astro` language; without the glob it
  // skips .astro entirely. The [astro] override keeps the Astro extension's
  // bundled Prettier from winning, since it cannot see prettier-plugin-tailwindcss.
  "prettier.documentSelectors": ["**/*.astro"],
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Import order belongs to Prettier (@ianvs/prettier-plugin-sort-imports).
  // TypeScript's `source.organizeImports` runs in mode "All" — it sorts, merges,
  // AND removes unused. Its sort groups `astro:*` with plain npm specifiers, while
  // the Prettier plugin gives them their own group ahead of `@/`, so enabling both
  // made every save flip the file between two orderings. `removeUnusedImports` is
  // the mode "RemoveUnused" half: it deletes unused bindings without sorting, so it
  // keeps the cleanup without fighting Prettier. Both set explicitly so a
  // user-level setting cannot silently switch sorting back on.
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.removeUnusedImports": "explicit"
    }
  },

  // Tailwind v4's @theme / @variant / @utility are unknown to VS Code's CSS server.
  "css.lint.unknownAtRules": "ignore",

  // Required for completions inside class="…".
  "editor.quickSuggestions": {
    "strings": "on"
  },

  "astro.content-intellisense": true
}
