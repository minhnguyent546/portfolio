# https://editorconfig.org/

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Mirrors .prettierrc (tabWidth 2, printWidth 80) so the editor and the
# formatter cannot disagree.
[*.{astro,ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,html,svg,md,mdx,yaml,yml}]
indent_size = 2
max_line_length = 80

# Two trailing spaces are a hard line break in Markdown.
[*.{md,mdx}]
trim_trailing_whitespace = false
