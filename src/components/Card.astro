---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, lang, pubDatetime, modDatetime, timezone } = data;
---

<li>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    {lang}
    class="group block py-4"
  >
    <Heading
      class="font-display text-h3 leading-tight font-medium text-ink-heading underline decoration-transparent decoration-[1.5px] underline-offset-4 transition-colors duration-(--dur-micro) group-hover:text-accent group-hover:decoration-current"
    >
      {title}
    </Heading>
    <Datetime
      {pubDatetime}
      {modDatetime}
      {timezone}
      uiLocale={lang}
      size="inherit"
      showIcon={false}
      class="mt-1.5 font-mono text-[0.78rem]"
    />
    <p class="mt-1 text-[0.95rem] leading-[1.55] text-ink-muted">
      {description}
    </p>
  </a>
</li>
