---
import config from "@/config";

const { socials } = config;

const LABELS: Record<string, string> = {
  mail: "Email",
  x: "X",
  linkedin: "LinkedIn",
  googleScholar: "Scholar",
  hackmd: "HackMD",
  github: "GitHub",
};

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    // mailto: hands off to the mail client; a new tab would open blank.
    const isMail = url.startsWith("mailto:") || name === "mail";
    const label = LABELS[name];
    return { label, url, title: linkTitle, Icon, isMail };
  })
);
---

<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5">
  {
    items.map(({ label, url, title, Icon, isMail }) =>
      Icon !== undefined && label ? (
        <a
          href={url}
          title={title}
          target={isMail ? undefined : "_blank"}
          rel={isMail ? undefined : "noopener noreferrer"}
          class="inline-flex items-center gap-1.5 py-0.5 text-meta whitespace-nowrap text-ink-muted transition-colors duration-(--dur-micro) hover:text-accent"
        >
          <Icon
            class="size-3.5 shrink-0 fill-current stroke-none"
            aria-hidden="true"
          />
          <span class="underline decoration-rule underline-offset-4 hover:decoration-current">
            {label}
          </span>
        </a>
      ) : null
    )
  }
</div>
