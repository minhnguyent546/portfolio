---
import config from "@/config";
import LinkButton from "./LinkButton.astro";

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    // mailto: hands off to the mail client; a new tab would open blank.
    const isMail = url.startsWith("mailto:") || name === "mail";
    const title =
      linkTitle ??
      (isMail
        ? `Send an email to ${site.title}`
        : `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`);
    return { name, url, title, Icon, isMail };
  })
);
---

<div class="flex flex-wrap items-center gap-1">
  {
    items.map(({ name, url, title, Icon, isMail }) =>
      Icon ? (
        <LinkButton
          href={url}
          class="p-2 hover:rotate-6 sm:p-1"
          title={title}
          target={isMail ? undefined : "_blank"}
          rel={isMail ? undefined : "noopener noreferrer"}
        >
          <Icon
            class={
              // googleScholar is a filled mark; the rest are stroked outlines.
              name === "googleScholar"
                ? "inline-block size-8 fill-current stroke-none opacity-90"
                : "inline-block size-8 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent"
            }
          />
          <span class="sr-only">{title}</span>
        </LinkButton>
      ) : null
    )
  }
</div>
