---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSystem from "@/assets/icons/IconSystem.svg";
import IconX from "@/assets/icons/IconX.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import LinkButton from "./LinkButton.astro";
import CommandPalette from "./palette/CommandPalette.astro";

type Props = {
  sections?: { id: string; label: string }[];
  /** Hide the sticky bar while scrolling down on reading pages; reveal on scroll up. */
  autoHide?: boolean;
};

const { sections = [], autoHide = false } = Astro.props;
const { site, features } = config;

// Blog reads the collection, so the link is dead until the first post exists.
// Hiding it keeps the nav honest, and it comes back with the first post.
const hasPosts =
  (await getCollection("blog", ({ data }) => !data.draft)).length > 0;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/site": "/site/blog/slug" → "/blog/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// The shell binds its own control keys and puts a text input under the
// visitor's fingers, so ⌘K stays out of its way.
const showPalette = features.search !== false && !isActive("/tty3");
---

<a
  lang="en"
  id="skip-to-content"
  href="#main-content"
  class="absolute inset-s-16 -top-full z-50 bg-paper px-3 py-2 text-accent backdrop-blur-lg transition-[top] focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  id="site-header"
  lang="en"
  data-auto-hide={autoHide ? "true" : undefined}
  class="sticky top-0 z-30 border-b border-rule bg-paper"
>
  <div
    class="app-layout flex items-center justify-between gap-x-2 py-3 sm:gap-x-4 sm:py-3.5"
  >
    {
      sections.length > 0 ? (
        <>
          <a
            href={getRelativeLocaleUrl(locale, "")}
            class="font-mono text-meta leading-none whitespace-nowrap text-ink-muted hover:text-accent md:hidden"
          >
            minhnguyent546
          </a>
          <nav aria-label="Sections" class="hidden md:block">
            <ul class="flex items-center gap-x-3.5 lg:gap-x-4">
              {sections.map(({ id, label }) => (
                <li>
                  <a
                    href={`#${id}`}
                    data-section-link={id}
                    class="group inline-flex py-1 text-meta whitespace-nowrap text-ink-muted transition-colors duration-(--dur-micro) hover:text-accent aria-[current]:font-medium aria-[current]:text-accent"
                  >
                    <span class="underline decoration-transparent underline-offset-4 group-hover:decoration-current group-aria-[current]:decoration-current">
                      {label}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </>
      ) : (
        <a
          href={getRelativeLocaleUrl(locale, "")}
          aria-label={`${t.nav.home} — ${site.title}`}
          title={t.nav.home}
          class="home-path -ms-1 inline-flex items-center px-1 py-1.5 font-mono text-sm leading-none font-medium whitespace-nowrap text-ink-heading hover:text-accent sm:text-lg"
        >
          <span class="home-path-tilde" aria-hidden="true">
            ~
          </span>
          <span class="home-path-full" aria-hidden="true">
            {"/home/minhnguyent546"}
          </span>
          <span aria-hidden="true">/</span>
        </a>
      )
    }
    <nav
      id="nav-menu"
      aria-label="Primary"
      class="flex items-center gap-x-1.5 sm:gap-x-3.5"
    >
      {
        hasPosts && (
          <a
            href={getRelativeLocaleUrl(locale, "blog")}
            class:list={[
              "px-1 py-1 text-meta font-medium whitespace-nowrap text-ink hover:text-accent",
              { "active-nav": isActive("/blog") },
            ]}
          >
            {t.nav.blog}
          </a>
        )
      }
      {
        features.search !== false && (
          <LinkButton
            id="search-link"
            href={getRelativeLocaleUrl(locale, "search")}
            class="relative size-8 shrink-0"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2" />
            <span class="sr-only">{t.nav.search}</span>
            {isActive("/search") && (
              <span
                aria-hidden="true"
                class="absolute inset-x-1.5 bottom-0.5 h-px rounded-full bg-current"
              />
            )}
          </LinkButton>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative size-8 shrink-0 hover:[&>svg]:stroke-accent"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
            data-mode-light={t.a11y.themeModeLight}
            data-mode-dark={t.a11y.themeModeDark}
            data-mode-system={t.a11y.themeModeSystem}
          >
            <IconSunHigh class="theme-icon theme-icon-sun absolute top-[50%] left-[50%] size-5 translate-[-50%] transition-transform" />
            <IconMoon class="theme-icon theme-icon-moon absolute top-[50%] left-[50%] size-5 translate-[-50%] transition-transform" />
            <IconSystem class="theme-icon theme-icon-system absolute top-[50%] left-[50%] size-5 translate-[-50%] transition-transform" />
          </button>
        )
      }
      {
        sections.length > 0 && (
          <button
            id="mobile-menu-btn"
            type="button"
            class="relative size-8 shrink-0 md:hidden hover:[&>svg]:stroke-accent"
            aria-expanded="false"
            aria-controls="mobile-section-menu"
            aria-label="Toggle section menu"
            title="Sections"
          >
            <IconMenuDeep
              data-menu-open
              class="absolute top-1/2 left-1/2 size-5 -translate-x-1/2 -translate-y-1/2"
              aria-hidden="true"
            />
            <IconX
              data-menu-close
              class="absolute top-1/2 left-1/2 hidden size-5 -translate-x-1/2 -translate-y-1/2"
              aria-hidden="true"
            />
          </button>
        )
      }
    </nav>
  </div>

  {
    sections.length > 0 && (
      <nav
        id="mobile-section-menu"
        aria-label="Sections"
        hidden
        class="border-t border-rule bg-paper md:hidden"
      >
        <ul class="app-layout grid grid-cols-2 gap-x-4 gap-y-1 py-2.5">
          {sections.map(({ id, label }) => (
            <li>
              <a
                href={`#${id}`}
                data-section-link={id}
                class="group inline-flex py-1.5 text-meta text-ink-muted hover:text-accent aria-[current]:font-medium aria-[current]:text-accent"
              >
                <span class="underline decoration-transparent underline-offset-4 group-hover:decoration-current group-aria-[current]:decoration-current">
                  {label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

{showPalette && <CommandPalette />}

<script>
  const header = document.querySelector<HTMLElement>("#site-header");
  const homePath = header?.querySelector<HTMLAnchorElement>(".home-path");
  const homePathFull = homePath?.querySelector<HTMLElement>(".home-path-full");

  if (homePath && homePathFull) {
    const defaultPath = homePathFull.textContent ?? "/home/minhnguyent546";
    const rollHomePath = () => {
      const isRoot = Math.random() < 0.1;
      homePath.toggleAttribute("data-root", isRoot);
      homePathFull.textContent = isRoot ? "/root" : defaultPath;
    };

    rollHomePath();
    homePathFull.addEventListener("transitionend", event => {
      if (
        event.propertyName === "width" &&
        !homePath.matches(":hover, :focus-visible")
      ) {
        rollHomePath();
      }
    });
  }

  const allLinks = [
    ...(header?.querySelectorAll<HTMLAnchorElement>("[data-section-link]") ??
      []),
  ];

  const menuBtn = document.querySelector<HTMLButtonElement>("#mobile-menu-btn");
  const mobileMenu = document.querySelector<HTMLElement>(
    "#mobile-section-menu"
  );
  const openIcon = menuBtn?.querySelector<SVGElement>("[data-menu-open]");
  const closeIcon = menuBtn?.querySelector<SVGElement>("[data-menu-close]");

  const setMenuOpen = (open: boolean) => {
    if (!menuBtn || !mobileMenu) return;
    menuBtn.setAttribute("aria-expanded", String(open));
    mobileMenu.hidden = !open;
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  };

  menuBtn?.addEventListener("click", () => {
    const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
    setMenuOpen(!isOpen);
  });

  document.addEventListener("keydown", event => {
    if (
      event.key === "Escape" &&
      menuBtn?.getAttribute("aria-expanded") === "true"
    ) {
      setMenuOpen(false);
      menuBtn.focus();
    }
  });

  document.addEventListener("click", event => {
    if (
      menuBtn?.getAttribute("aria-expanded") === "true" &&
      header &&
      !header.contains(event.target as Node)
    ) {
      setMenuOpen(false);
    }
  });

  if (header && allLinks.length > 0) {
    const ids = [
      ...new Set(
        allLinks
          .map(link => link.dataset.sectionLink)
          .filter((id): id is string => Boolean(id))
      ),
    ];
    const sections = ids
      .map(id => ({ id, el: document.getElementById(id) }))
      .filter((item): item is { id: string; el: HTMLElement } =>
        Boolean(item.el)
      );

    if (sections.length > 0) {
      const mark = (activeId: string | null) => {
        for (const link of allLinks) {
          if (activeId !== null && link.dataset.sectionLink === activeId) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      };

      // Pin a clicked section until the reader scrolls manually so short
      // bottom sections stay highlighted after jumping to them.
      let pinned: string | null = null;

      const sync = () => {
        if (pinned !== null) return;

        const barHeight =
          header.firstElementChild?.getBoundingClientRect().height ?? 56;
        const line = Math.max(barHeight + 12, innerHeight * 0.3);
        const atEnd =
          scrollY + innerHeight >= document.documentElement.scrollHeight - 2;

        let current: string | null = sections[sections.length - 1].id;
        if (!atEnd) {
          current = null;
          for (const { id, el } of sections) {
            if (el.getBoundingClientRect().top <= line) current = id;
          }
        }
        mark(current);
      };

      for (const link of allLinks) {
        link.addEventListener("click", () => {
          const id = link.dataset.sectionLink;
          if (id) {
            pinned = id;
            mark(id);
          }
          setMenuOpen(false);
        });
      }

      for (const event of ["wheel", "touchstart", "keydown"]) {
        addEventListener(event, () => (pinned = null), { passive: true });
      }

      let ticking = false;
      const requestSync = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          sync();
          ticking = false;
        });
      };

      addEventListener("scroll", requestSync, { passive: true });
      addEventListener("resize", requestSync, { passive: true });
      sync();
    }
  }

  if (header?.dataset.autoHide === "true") {
    let lastY = scrollY;
    let hidden = false;
    let ticking = false;

    const setHidden = (next: boolean) => {
      if (next === hidden) return;
      hidden = next;
      header.dataset.hidden = String(next);
    };

    const update = () => {
      const y = Math.max(0, scrollY);
      const delta = y - lastY;
      if (y <= 80) {
        setHidden(false);
        lastY = y;
      } else if (delta > 8) {
        setHidden(true);
        lastY = y;
      } else if (delta < -6) {
        setHidden(false);
        lastY = y;
      }
      ticking = false;
    };

    addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    // Keyboard users tabbing into the header must see it immediately.
    header.addEventListener("focusin", () => setHidden(false));
  }
</script>

<style>
  #site-header[data-auto-hide="true"] {
    transition: transform 280ms var(--ease-out);
  }

  #site-header[data-auto-hide="true"][data-hidden="true"] {
    transform: translateY(-100%);
    pointer-events: none;
  }

  /* Three-state theme icon: sun in light, moon in dark, the auto mark in system
     mode. `data-theme-mode` is set on <html> by the FOUC script before paint
     and kept in sync by theme.ts, so the icon never flashes a wrong state. */
  .theme-icon-sun,
  .theme-icon-moon {
    scale: 0;
    rotate: -90deg;
  }
  .theme-icon-system {
    scale: 1;
    rotate: 0;
  }
  html[data-theme-mode="light"] .theme-icon-sun {
    scale: 1;
    rotate: 0;
  }
  html[data-theme-mode="light"] .theme-icon-moon,
  html[data-theme-mode="light"] .theme-icon-system {
    scale: 0;
    rotate: -90deg;
  }
  html[data-theme-mode="dark"] .theme-icon-moon {
    scale: 1;
    rotate: 0;
  }
  html[data-theme-mode="dark"] .theme-icon-sun,
  html[data-theme-mode="dark"] .theme-icon-system {
    scale: 0;
    rotate: -90deg;
  }

  /* The visible icon rotates and scales into place smoothly rather than
     clicking between two states. The page crossfade comes from the View
     Transition wrapping the toggle in theme.ts. */
  .theme-icon {
    transition:
      scale var(--dur-micro) ease,
      rotate var(--dur-long) ease;
  }

  /* Reserve the expanded path's width so the hover/tap target spans
     `/home/minhnguyent546/` rather than just the two-character `~/`. */
  .home-path {
    --home-path-dur: 380ms;
    --home-path-hold: 175ms;
    min-width: calc(21ch + 0.5rem);
    transition: color var(--home-path-dur) ease var(--home-path-hold);
  }

  .home-path:hover,
  .home-path:focus-visible {
    transition: color var(--dur-micro) ease 0s;
  }

  .home-path-tilde,
  .home-path-full {
    display: inline-block;
    overflow: hidden;
    /* Keep descenders (g, y) clear of the clip box. */
    padding-block: 0.15em;
    margin-block: -0.15em;
  }

  .home-path-tilde {
    width: 1ch;
    transition: width 0s calc(var(--home-path-hold) + var(--home-path-dur));
  }

  .home-path-full {
    width: 0ch;
    transition: width var(--home-path-dur) steps(20, end) var(--home-path-hold);
  }

  .home-path[data-root] {
    --home-path-dur: 95ms;
  }

  .home-path[data-root] .home-path-full {
    transition: width var(--home-path-dur) steps(5, end) var(--home-path-hold);
  }

  .home-path:hover .home-path-tilde,
  .home-path:focus-visible .home-path-tilde {
    width: 0ch;
    transition-delay: 0s;
  }

  .home-path:hover .home-path-full,
  .home-path:focus-visible .home-path-full {
    width: 20ch;
    transition-delay: 0s;
  }

  .home-path[data-root]:hover .home-path-full,
  .home-path[data-root]:focus-visible .home-path-full {
    width: 5ch;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-path,
    .home-path[data-root] {
      --home-path-dur: 0s;
      --home-path-hold: 0s;
    }
  }
</style>
