---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSystem from "@/assets/icons/IconSystem.svg";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import LinkButton from "./LinkButton.astro";
import CommandPalette from "./palette/CommandPalette.astro";

const { site, features } = config;

// Blog reads the collection, so the link is dead until the first post exists.
// Hiding it keeps the nav honest, and it comes back with the first post.
const hasPosts =
  (await getCollection("blog", ({ data }) => !data.draft)).length > 0;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/site": "/site/blog/slug" → "/blog/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// The shell binds its own control keys and puts a text input under the
// visitor's fingers, so ⌘K stays out of its way.
const showPalette = features.search !== false && !isActive("/tty3");
---

<a
  lang="en"
  id="skip-to-content"
  href="#main-content"
  class="absolute inset-s-16 -top-full z-50 bg-paper px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header lang="en" class="app-layout">
  <div
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-rule bg-paper py-4 sm:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="text-xl leading-none font-semibold whitespace-nowrap hover:text-accent sm:text-2xl"
    >
      {site.title}
    </a>
    <nav id="nav-menu" class="flex items-center gap-x-5">
      {
        hasPosts && (
          <a
            href={getRelativeLocaleUrl(locale, "blog")}
            class:list={[
              "py-1 font-medium hover:text-accent",
              { "active-nav": isActive("/blog") },
            ]}
          >
            {t.nav.blog}
          </a>
        )
      }
      {
        features.search !== false && (
          <LinkButton
            id="search-link"
            href={getRelativeLocaleUrl(locale, "search")}
            class="focus-outline relative size-8"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
            <span class="sr-only">{t.nav.search}</span>
            {isActive("/search") && (
              <IconUnderline
                aria-hidden="true"
                class="absolute bottom-0 w-6 scale-125"
              />
            )}
          </LinkButton>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative size-8 hover:[&>svg]:stroke-accent"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
            data-mode-light={t.a11y.themeModeLight}
            data-mode-dark={t.a11y.themeModeDark}
            data-mode-system={t.a11y.themeModeSystem}
          >
            <IconSunHigh class="theme-icon theme-icon-sun absolute top-[50%] left-[50%] translate-[-50%] transition-transform" />
            <IconMoon class="theme-icon theme-icon-moon absolute top-[50%] left-[50%] translate-[-50%] transition-transform" />
            <IconSystem class="theme-icon theme-icon-system absolute top-[50%] left-[50%] translate-[-50%] transition-transform" />
          </button>
        )
      }
    </nav>
  </div>
</header>

{showPalette && <CommandPalette />}

<style>
  /* Three-state theme icon: sun in light, moon in dark, the auto mark in system
     mode. `data-theme-mode` is set on <html> by the FOUC script before paint
     and kept in sync by theme.ts, so the icon never flashes a wrong state. */
  .theme-icon-sun,
  .theme-icon-moon {
    scale: 0;
    rotate: -90deg;
  }
  .theme-icon-system {
    scale: 1;
    rotate: 0;
  }
  html[data-theme-mode="light"] .theme-icon-sun {
    scale: 1;
    rotate: 0;
  }
  html[data-theme-mode="light"] .theme-icon-moon,
  html[data-theme-mode="light"] .theme-icon-system {
    scale: 0;
    rotate: -90deg;
  }
  html[data-theme-mode="dark"] .theme-icon-moon {
    scale: 1;
    rotate: 0;
  }
  html[data-theme-mode="dark"] .theme-icon-sun,
  html[data-theme-mode="dark"] .theme-icon-system {
    scale: 0;
    rotate: -90deg;
  }
</style>
