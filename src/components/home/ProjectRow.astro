---
import type { CollectionEntry } from "astro:content";
import LinkRow from "./LinkRow.astro";

type Props = { entry: CollectionEntry<"projects"> };

const { title, summary, stack, repo, links } = Astro.props.entry.data;

const allLinks = [
  ...(repo ? [{ label: "Repository", url: repo }] : []),
  ...links,
];
---

<article
  class="grid gap-x-6 gap-y-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[11rem_minmax(0,1fr)]"
>
  <div class="min-w-0">
    <h3
      class="font-mono text-body font-semibold wrap-anywhere text-ink-heading"
    >
      {title}
    </h3>
    <LinkRow links={allLinks} class="mt-1" />
  </div>

  <div class="min-w-0">
    <p class="max-w-[65ch] text-body leading-[1.6] text-ink">{summary}</p>
    {
      stack.length > 0 && (
        <ul class="mt-1.5 flex flex-wrap gap-x-2 gap-y-0.5 text-meta text-ink-muted">
          {stack.map(item => (
            <li class="after:ms-2 after:text-rule after:content-['/'] last:after:content-none">
              {item}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
