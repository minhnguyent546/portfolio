---
import { Image } from "astro:assets";
import avatar from "@/assets/images/avatar.jpg";
import Socials from "@/components/Socials.astro";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const { site } = config;
---

<section id="hero" class="app-layout pt-7 pb-6 sm:pt-9 sm:pb-7">
  <div
    class="grid items-start gap-x-8 gap-y-6 md:grid-cols-[minmax(0,1fr)_15.5rem]"
  >
    <div
      class="max-w-[65ch] min-w-0 space-y-2.5 text-body leading-[1.6] text-pretty text-ink [&_a]:text-accent [&_a]:underline [&_a]:decoration-rule [&_a]:underline-offset-3 [&_a:hover]:decoration-current [&_strong]:font-semibold"
    >
      <slot />
    </div>

    <aside
      class="order-first flex flex-col items-center text-center md:order-none md:mt-1"
    >
      <Image
        src={avatar}
        alt={`Portrait of ${site.author}`}
        width={224}
        densities={[1, 2]}
        loading="eager"
        class="aspect-square w-36 rounded-sm border border-rule object-cover sm:w-44 md:w-52"
      />

      <h1
        class="mt-3.5 font-display text-[1.4375rem] leading-tight font-semibold tracking-[-0.02em] whitespace-nowrap text-ink-heading sm:text-[1.5rem]"
      >
        {site.author}
      </h1>
      <p class="mt-0.5 text-meta font-medium text-ink-muted">AI Researcher</p>

      <a
        href={getAssetPath("cv.pdf")}
        class="mt-3.5 inline-flex items-center justify-center border border-accent px-5 py-1.5 text-meta font-medium whitespace-nowrap text-accent transition-colors duration-(--dur-micro) hover:bg-accent hover:text-accent-ink md:w-52"
      >
        Curriculum vitae
      </a>

      <div class="mt-3 w-full max-w-64 md:max-w-none">
        <Socials />
      </div>
    </aside>
  </div>
</section>
