---
import ExternalLink from "./ExternalLink.astro";

type Props = {
  links: { label: string; url: string }[];
  class?: string;
};

const { links, class: className } = Astro.props;
---

{
  links.length > 0 && (
    <ul class:list={["flex flex-wrap gap-x-3.5 gap-y-0.5", className]}>
      {links.map(({ label, url }) => (
        <li>
          <ExternalLink {label} {url} />
        </li>
      ))}
    </ul>
  )
}
