---
/**
 * The row of outbound links under an entry. Every link leaves the site, so
 * they all carry the same target and the same trailing mark.
 */
type Props = {
  links: { label: string; url: string }[];
  class?: string;
};

const { links, class: className } = Astro.props;
---

{
  links.length > 0 && (
    <ul class:list={["flex flex-wrap gap-x-4 gap-y-1", className]}>
      {links.map(({ label, url }) => (
        <li>
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block py-1 text-meta text-accent underline decoration-rule underline-offset-4 hover:decoration-current"
          >
            {label}
            <span aria-hidden="true"> ↗</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
