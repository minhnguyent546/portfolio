---
/**
 * In-page index for the homepage sections. Sticks under the masthead so the
 * eight sections stay reachable while scrolling.
 *
 * The numerals repeat the one in each section's heading rail, which is what
 * separates this strip from the masthead above it: a numbered row reads as a
 * table of contents, not as a second site menu. They come from array position,
 * which the scroll spy below already requires to match DOM order.
 *
 * `scroll-padding-top` in global.css matches the height of this strip; change
 * one and the anchor jumps land under the other.
 */
type Props = {
  items: { id: string; label: string }[];
};

const { items } = Astro.props;
---

<nav
  id="section-nav"
  aria-label="Sections"
  class="sticky top-0 z-30 border-b border-rule bg-paper/90 backdrop-blur-sm"
>
  <ul
    class="app-layout flex snap-x scroll-px-4 [scrollbar-width:none] gap-x-5 overflow-x-auto py-3 whitespace-nowrap [&::-webkit-scrollbar]:hidden"
  >
    {
      items.map(({ id, label }, i) => (
        <li class="snap-start">
          <a
            href={`#${id}`}
            class="group inline-flex items-baseline gap-1.5 py-1 text-ink-muted hover:text-accent aria-[current]:text-accent"
          >
            <span
              aria-hidden="true"
              class="font-mono text-[0.6875rem] tracking-[0.1em] tabular-nums opacity-60 group-aria-[current]:opacity-100"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="underline decoration-transparent underline-offset-4 group-hover:decoration-current group-aria-[current]:decoration-current">
              {label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("#section-nav");
  const links = [
    ...(nav?.querySelectorAll<HTMLAnchorElement>("a[href^='#']") ?? []),
  ];
  const sections = links
    .map(link => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section != null);

  if (nav && sections.length === links.length) {
    const mark = (current: number) =>
      links.forEach((link, i) => {
        if (i === current) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });

    // The last two sections are shorter than the viewport, so their tops never
    // reach the reading line — a click on them lands at the page bottom. Pin
    // the clicked link until the reader scrolls under their own steam.
    let pinned: number | null = null;

    const sync = () => {
      if (pinned !== null) return;

      const line = Math.max(
        nav.getBoundingClientRect().height + 8,
        innerHeight * 0.35
      );
      // Nothing can sit at the line once scrolling has bottomed out, so the end
      // of the page selects the last section outright.
      const atEnd =
        scrollY + innerHeight >= document.documentElement.scrollHeight - 2;

      let current = sections.length - 1;
      if (!atEnd) {
        current = 0;
        sections.forEach((section, i) => {
          if (section.getBoundingClientRect().top <= line) current = i;
        });
      }
      mark(current);
    };

    links.forEach((link, i) =>
      link.addEventListener("click", () => {
        pinned = i;
        mark(i);
      })
    );

    for (const event of ["wheel", "touchstart", "keydown"]) {
      addEventListener(event, () => (pinned = null), { passive: true });
    }

    addEventListener("scroll", sync, { passive: true });
    addEventListener("resize", sync, { passive: true });
    sync();
  }
</script>
