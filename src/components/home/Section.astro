---
import type { HTMLAttributes } from "astro/types";

type Props = {
  id: string;
  title: string;
} & HTMLAttributes<"section">;

const { id, title, class: className, ...attrs } = Astro.props;
---

<section id={id} class:list={["app-layout py-5 sm:py-6", className]} {...attrs}>
  <h2
    class="mb-4 border-b border-rule pb-2 font-display text-h2 font-semibold tracking-[-0.015em] wrap-anywhere text-ink-heading"
  >
    {title}
  </h2>
  <slot />
</section>
