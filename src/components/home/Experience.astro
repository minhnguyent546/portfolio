---
import type { CollectionEntry } from "astro:content";

type Props = { entries: CollectionEntry<"experience">[] };

const { entries } = Astro.props;
---

<ol class="divide-y divide-rule/70">
  {
    entries.map(entry => (
      <li class="grid gap-x-6 gap-y-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[11rem_minmax(0,1fr)]">
        <p class="pt-0.5 text-meta text-ink-muted tabular-nums">
          {entry.data.period}
        </p>
        <div class="min-w-0">
          <p class="text-body leading-snug text-ink-heading">
            <span class="font-semibold">{entry.data.role}</span>
            <span class="text-ink-muted"> · </span>
            <span class="text-ink">{entry.data.organization}</span>
            {entry.data.orgNote && (
              <span class="text-meta text-ink-muted">
                {" "}
                ({entry.data.orgNote})
              </span>
            )}
          </p>
          {entry.data.highlights.length > 0 && (
            <ul class="mt-2 max-w-[65ch] list-disc space-y-1.5 ps-4 text-body leading-[1.6] text-ink marker:text-ink-muted">
              {entry.data.highlights.map(highlight => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
