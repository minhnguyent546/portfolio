---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import IconFileText from "@/assets/icons/IconFileText.svg";
import config from "@/config";
import { formatDate } from "@/utils/formatDate";
import ExternalLink from "./ExternalLink.astro";

type Props = { entry: CollectionEntry<"publications"> };

const { entry } = Astro.props;
const {
  title,
  shortTitle,
  authors,
  venue,
  date,
  arxivId,
  doi,
  links,
  thumbnail,
  abstract,
} = entry.data;

const { label, datetime } = formatDate(date, "month-short");
const thumbnailWidths = thumbnail
  ? [176, 320, 448, 640, thumbnail.width].filter(
      (width, index, widths) =>
        width <= thumbnail.width && widths.indexOf(width) === index
    )
  : [];

// Built here rather than stored, so an id change cannot leave a stale URL.
const allLinks = [
  ...(doi ? [{ label: "DOI", url: `https://doi.org/${doi}` }] : []),
  ...(arxivId
    ? [{ label: `arXiv:${arxivId}`, url: `https://arxiv.org/abs/${arxivId}` }]
    : []),
  ...links,
];
---

<article
  class="grid gap-4 py-5 first:pt-0 last:pb-0 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-start sm:gap-6"
>
  {
    thumbnail && (
      <div class="hidden overflow-hidden rounded-xs border border-rule bg-white p-1.5 sm:flex sm:h-32 sm:w-full sm:items-center sm:justify-center">
        <Image
          src={thumbnail}
          alt=""
          widths={thumbnailWidths}
          sizes="11rem"
          format="webp"
          quality={95}
          loading="lazy"
          decoding="async"
          class="max-h-full max-w-full object-contain"
        />
      </div>
    )
  }

  <div class="min-w-0">
    <h3
      class="font-display text-h3 leading-snug font-semibold wrap-anywhere text-ink-heading"
    >
      {title}
    </h3>

    <p class="mt-1 max-w-[65ch] text-meta leading-snug text-ink-muted">
      {
        authors.map((name, i) => (
          <>
            {i > 0 && ", "}
            <span
              class:list={{
                // The `*` marks equal contribution; the name must still match.
                "font-semibold text-ink":
                  name.replace(/\*+$/, "") === config.site.author,
              }}
            >
              {name}
            </span>
          </>
        ))
      }
    </p>

    <p class="mt-1 max-w-[65ch] text-meta leading-snug">
      <span class="font-medium text-ink">{venue}</span>
      <span class="text-ink-muted tabular-nums">
        {" · "}
        <time datetime={datetime}>{label}</time>
      </span>
    </p>

    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-meta">
      {
        allLinks.map(({ label: linkLabel, url }) => (
          <ExternalLink label={linkLabel} {url} />
        ))
      }

      <details class="group [&[open]]:basis-full">
        <summary
          class="group/toggle inline-flex cursor-pointer list-none items-center gap-1.5 py-0.5 whitespace-nowrap text-accent select-none [&::-webkit-details-marker]:hidden"
        >
          <IconFileText
            class="size-3.5 shrink-0 fill-none stroke-current text-ink-muted transition-colors duration-(--dur-micro) group-open:text-accent group-hover/toggle:text-accent"
            aria-hidden="true"
          />
          <span
            class="underline decoration-rule underline-offset-4 group-open:hidden group-hover/toggle:decoration-current"
          >
            Abstract
          </span>
          <span
            class="hidden underline decoration-current underline-offset-4 group-open:inline"
          >
            Hide abstract
          </span>
          <span class="sr-only">{shortTitle}</span>
        </summary>
        <p
          class="mt-2 max-w-[65ch] rounded-xs border border-rule bg-paper-alt p-3.5 text-meta leading-relaxed text-ink"
        >
          {abstract}
        </p>
      </details>
    </div>
  </div>
</article>
