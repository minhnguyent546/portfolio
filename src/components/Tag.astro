---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `blog/tags/${tag}/`)}
    class:list={[
      "inline-flex items-center gap-1 rounded-full border border-rule bg-paper-alt/60 text-ink-muted transition-colors duration-(--dur-micro)",
      "hover:border-ink-muted hover:text-ink-heading",
      size === "sm"
        ? "px-2.5 py-0.5 font-mono text-[0.78rem]"
        : "px-3 py-1 font-app text-[0.92rem]",
    ]}
  >
    <span aria-hidden="true" class="text-ink-muted/60">#</span>
    <span>{tagName}</span>
  </a>
</li>
