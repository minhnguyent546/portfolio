---
import type { HTMLAttributes } from "astro/types";
import config from "@/config";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  lang="en"
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="flex flex-col items-center gap-y-1 border-t border-rule py-6 text-meta text-ink-muted sm:py-4"
  >
    <span>&#169; {currentYear} {config.site.author}</span>
    <span>{t.footer.allRightsReserved}</span>
  </div>
</footer>
