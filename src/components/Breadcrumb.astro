---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { TOPIC_LABELS, type Topic } from "@/data/topics";
import { useTranslations } from "@/i18n";
import { stripBase, stripLocale } from "@/utils/withBase";

type Crumb = { label: string; href?: string };

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const segments = currentUrlPath.split("/").filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  blog: t.nav.blog,
  tags: t.nav.tags,
  archives: t.nav.archives,
  search: t.nav.search,
};

// Each href is the whole path up to its segment, not the segment alone.
const crumbs: Crumb[] = segments.map((segment, index) => ({
  label: navLabels[segment] ?? decodeSegment(segment),
  href: getRelativeLocaleUrl(locale, segments.slice(0, index + 1).join("/")),
}));

// Home > Blog > topic > [topic] => Home > Blog > [label].
// `/blog/topic` is not a page, so the pair collapses to one unlinked crumb.
if (segments[0] === "blog" && segments[1] === "topic") {
  const topic = decodeSegment(segments[2] ?? "");
  crumbs.splice(1, 2, { label: TOPIC_LABELS[topic as Topic] ?? topic });
}

// Home > Tags > [tag] > [page] => Home > Tags > [tag] (page n).
// Page 1 is served at /tags/[tag], so this segment is always 2 or higher.
if (segments[0] === "tags" && !isNaN(Number(segments[2]))) {
  const tag = decodeSegment(segments[1]);
  crumbs.splice(1, 3, {
    label: `${tag} (${t.pagination.page.toLowerCase()} ${segments[2]})`,
  });
}

crumbs.unshift({ label: t.nav.home, href: getRelativeLocaleUrl(locale, "") });

// The page you are on is not a link to itself.
delete crumbs[crumbs.length - 1].href;
---

<nav class="app-layout mt-6 mb-2" aria-label="Breadcrumb">
  <ol
    class="flex flex-wrap items-center gap-x-2 font-mono text-meta text-ink-muted"
  >
    {
      crumbs.map((crumb, index) => (
        <li class="flex min-w-0 items-center gap-x-2">
          {index > 0 && (
            <span aria-hidden="true" class="text-rule">
              /
            </span>
          )}
          {crumb.href ? (
            <a
              href={crumb.href}
              class="-my-1 inline-block min-w-0 py-1 break-words underline-offset-4 hover:text-accent hover:underline"
            >
              {crumb.label}
            </a>
          ) : (
            <span
              class="min-w-0 break-words text-ink-heading"
              aria-current="page"
            >
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
