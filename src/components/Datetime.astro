---
import dayjs from "dayjs";
import timezone from "dayjs/plugin/timezone";
import utc from "dayjs/plugin/utc";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  uiLocale?: "en" | "vi";
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  uiLocale = "en",
} = Astro.props;

const t = useTranslations(uiLocale);

const isModified =
  modDatetime &&
  new Date(modDatetime).getTime() > new Date(pubDatetime).getTime();

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  postTimezone ?? config.site.timezone
);

const date = new Intl.DateTimeFormat(uiLocale === "vi" ? "vi-VN" : "en-US", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: postTimezone ?? config.site.timezone,
}).format(new Date(isModified ? modDatetime : pubDatetime));
---

<div class:list={["flex items-center gap-x-2 text-ink-muted", className]}>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span class:list={["text-meta", { "text-body": size === "lg" }]}>
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={["text-meta", { "text-body": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
</div>
