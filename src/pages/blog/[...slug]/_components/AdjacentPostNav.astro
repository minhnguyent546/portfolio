---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { getPostUrl } from "@/utils/getPostPaths";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
  lang: "en" | "vi";
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
  uiLocale?: "en" | "vi";
};

const { prevPost, nextPost, uiLocale = "en" } = Astro.props;
const routeLocale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(uiLocale);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, routeLocale)}
        class="flex w-full gap-1 hover:opacity-75"
      >
        <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
        <div>
          <span>{t.post.previousPost}</span>
          <div lang={prevPost.lang} class="text-sm text-accent/85">
            {prevPost.title}
          </div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, routeLocale)}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
      >
        <div>
          <span>{t.post.nextPost}</span>
          <div lang={nextPost.lang} class="text-sm text-accent/85">
            {nextPost.title}
          </div>
        </div>
        <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</div>
