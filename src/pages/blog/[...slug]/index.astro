---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Datetime from "@/components/Datetime.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PostTOC from "@/components/PostTOC.astro";
import Tag from "@/components/Tag.astro";
import config from "@/config";
import { TOPIC_LABELS } from "@/data/topics";
import { tplStr, useTranslations } from "@/i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getReadingTime } from "@/utils/getReadingTime";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getTranslation } from "@/utils/getTranslation";
import { slugifyStr } from "@/utils/slugify";
import { tocHeadingPattern } from "@/utils/tocHeading";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import BackButton from "./_components/BackButton.astro";
import EditPost from "./_components/EditPost.astro";
import LangSwitch from "./_components/LangSwitch.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sortedPosts = getSortedPosts(posts);

  // Declared inside: Astro extracts `getStaticPaths` into its own chunk, so a
  // sibling top-level function is not in scope at build time.
  const toAdjacentPost = (post: CollectionEntry<"blog">) => ({
    id: post.id,
    title: post.data.title,
    filePath: post.filePath,
    lang: post.data.lang,
  });

  return sortedPosts.map(post => {
    // Neighbours stay in the reader's language. The other half of a translated
    // pair is reachable through the language switch, not the prev/next nav.
    const siblings = sortedPosts.filter(p => p.data.lang === post.data.lang);
    const index = siblings.findIndex(p => p.id === post.id);

    return {
      params: { slug: getPostSlug(post.id, post.filePath) },
      props: {
        post,
        translation: getTranslation(post, sortedPosts) ?? null,
        prevPost: index > 0 ? toAdjacentPost(siblings[index - 1]) : null,
        nextPost:
          index < siblings.length - 1
            ? toAdjacentPost(siblings[index + 1])
            : null,
      },
    };
  });
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
  lang: "en" | "vi";
} | null;

type Props = {
  post: CollectionEntry<"blog">;
  translation: CollectionEntry<"blog"> | null;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, translation, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  topic,
  hideEditPost,
  lang,
} = post.data;

const t = useTranslations(lang);
const minutes = getReadingTime(post);

const { Content, headings, remarkPluginFrontmatter } = await render(post);
const tocHtml = (remarkPluginFrontmatter.tocHtml ?? {}) as Record<
  string,
  string
>;
const tocHeadings = headings
  .filter(
    h => (h.depth === 2 || h.depth === 3) && !tocHeadingPattern.test(h.text)
  )
  .map(h => ({ ...h, html: tocHtml[h.slug] }));

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  {lang}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header autoHide />

  <PostTOC headings={tocHeadings} label={t.post.onThisPage} />

  <main
    id="main-content"
    class="mx-auto w-full max-w-[44.5rem] px-5"
    data-pagefind-body
    data-pagefind-meta={`lang:${lang}`}
    data-copy-label={t.post.copyCode}
    data-copied-label={t.post.copiedCode}
    data-zoom-label={t.post.zoomImage}
    data-preview-label={t.post.imagePreview}
    data-close-preview-label={t.post.closeImagePreview}
    data-heading-link-label={t.post.linkToHeading}
  >
    <header
      class="mx-auto max-w-[42rem] border-b border-rule pt-9 pb-7 text-center sm:pt-10 sm:pb-8"
    >
      <div
        class="mb-3 inline-flex flex-wrap items-center justify-center gap-x-2 font-mono text-[11.5px] tracking-[0.06em]"
      >
        {
          config.features.showBackButton && (
            <>
              <BackButton uiLocale={lang} inline />
              <span aria-hidden="true" class="text-ink-muted/50">
                /
              </span>
            </>
          )
        }
        <a
          href={getRelativeLocaleUrl(locale, `blog/topic/${topic}`)}
          class="font-medium tracking-[0.08em] text-accent uppercase hover:underline hover:underline-offset-4"
        >
          {TOPIC_LABELS[topic]}
        </a>
      </div>

      <h1
        class="mx-auto max-w-[39rem] font-display text-[clamp(1.7rem,1.5944rem+0.4507vw,2rem)] leading-[1.26] font-semibold tracking-[-0.018em] text-balance text-ink-heading"
      >
        {title}
      </h1>

      {
        description && (
          <p class="mx-auto mt-3.5 max-w-[37rem] font-app text-[0.96rem] leading-[1.55] text-ink-muted">
            {description}
          </p>
        )
      }

      <div
        class="mt-5 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1.5 font-app text-[0.825rem] text-ink-muted"
      >
        <Datetime
          {pubDatetime}
          {modDatetime}
          {timezone}
          uiLocale={lang}
          size="inherit"
          showIcon={false}
        />
        <span aria-hidden="true" class="opacity-40">&middot;</span>
        <span>{tplStr(t.post.minRead, { minutes })}</span>
        {
          translation && (
            <>
              <span aria-hidden="true" class="opacity-40">
                &middot;
              </span>
              <LangSwitch {post} {translation} />
            </>
          )
        }
        {
          config.features.editPost?.enabled && !hideEditPost && (
            <>
              <span aria-hidden="true" class="opacity-40 max-sm:hidden">
                &middot;
              </span>
              <EditPost
                {hideEditPost}
                {post}
                uiLocale={lang}
                class="items-center max-sm:hidden [&_svg]:size-3.5"
              />
            </>
          )
        }
      </div>
    </header>

    <article
      id="article"
      class:list={[
        "mx-auto mt-9 w-full",
        "app-prose max-w-[42rem] font-display text-[1.0625rem] leading-[1.68]",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <div class="mx-auto max-w-[42rem]">
      {
        tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-1.5">
            {tags.map(tag => (
              <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
            ))}
          </ul>
        )
      }

      <EditPost
        class="mt-6 text-[0.825rem] sm:hidden [&_svg]:size-4"
        {hideEditPost}
        {post}
        uiLocale={lang}
      />

      <BackToTopButton uiLocale={lang} />

      <hr class="my-8 border-rule" />

      <AdjacentPostNav {prevPost} {nextPost} uiLocale={lang} />
    </div>
  </main>
  <Footer class="sm:pb-20 lg:pb-0" />

  <script>
    function addHeadingLinks() {
      const labelTemplate =
        document.getElementById("main-content")?.dataset.headingLinkLabel ??
        "Link to section: %s";
      const headings = Array.from(
        document.querySelectorAll<HTMLHeadingElement>(
          "#article :is(h2, h3, h4, h5, h6)"
        )
      );
      for (const heading of headings) {
        if (!heading.id) continue;
        heading.classList.add("group");
        const link = document.createElement("a");
        link.className =
          "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
        link.href = "#" + heading.id;
        // The "#" is decorative, so the link needs a name of its own.
        link.ariaLabel = labelTemplate.replace(
          "%s",
          (heading.textContent ?? "").trim()
        );

        const span = document.createElement("span");
        span.ariaHidden = "true";
        span.textContent = "#";
        link.appendChild(span);
        heading.appendChild(link);
      }
    }
    addHeadingLinks();

    function attachCopyButtons() {
      const main = document.getElementById("main-content");
      const copyButtonLabel = main?.dataset.copyLabel ?? "Copy";
      const copiedButtonLabel = main?.dataset.copiedLabel ?? "Copied";
      const codeBlocks = Array.from(
        document.querySelectorAll<HTMLPreElement>("pre")
      );

      for (const codeBlock of codeBlocks) {
        const wrapper = document.createElement("div");
        wrapper.style.position = "relative";

        // transformerFileName sets `--file-name-offset` inline on `<pre>`.
        // Reading inline style avoids forcing a style recalculation per block.
        const hasFileNameOffset =
          codeBlock.style.getPropertyValue("--file-name-offset").trim() !== "";

        const topClass = hasFileNameOffset
          ? "top-(--file-name-offset)"
          : "-top-3";

        const copyButton = document.createElement("button");
        copyButton.className = `copy-code absolute end-3 ${topClass} rounded border border-rule bg-paper px-2 py-1 text-xs leading-4 font-medium text-ink-muted hover:text-ink`;
        copyButton.textContent = copyButtonLabel;
        // Shiki adds tabindex="0" to every <pre>. The Copy button keeps it:
        // without a tab stop on the block, keyboard users cannot reach the
        // start of an overflowing line.
        codeBlock.appendChild(copyButton);

        codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
        wrapper.appendChild(codeBlock);

        copyButton.addEventListener("click", async () => {
          await copyCode(codeBlock, copyButton);
        });
      }

      async function copyCode(block: HTMLElement, button: HTMLButtonElement) {
        const code = block.querySelector("code");
        const text = code?.innerText;

        await navigator.clipboard.writeText(text ?? "");

        button.textContent = copiedButtonLabel;

        setTimeout(() => {
          button.textContent = copyButtonLabel;
        }, 700);
      }
    }
    attachCopyButtons();

    /** Accessible image lightbox for article images. */
    function initLightbox() {
      const article = document.getElementById("article");
      const main = document.getElementById("main-content");
      if (!article || !main) return;

      const zoomLabel = main.dataset.zoomLabel ?? "Zoom image";
      const previewLabel = main.dataset.previewLabel ?? "Image preview";
      const closePreviewLabel =
        main.dataset.closePreviewLabel ?? "Close image preview";

      const prefersReducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let overlay: HTMLDivElement | null = null;
      let lastFocused: Element | null = null;

      // Defer attribute mutations so they don't push the LCP timestamp.
      // Event listeners below use delegation and don't need the attributes to exist yet.
      requestAnimationFrame(() => {
        const images = Array.from(article.querySelectorAll("img"));
        for (const image of images) {
          if (image.closest("a")) continue;
          image.setAttribute("role", "button");
          image.setAttribute("tabindex", "0");
          image.setAttribute("aria-haspopup", "dialog");
          image.setAttribute(
            "aria-label",
            image.alt ? `${zoomLabel}: ${image.alt}` : zoomLabel
          );
        }
      });

      function open(src: string, alt: string, trigger?: Element) {
        if (overlay) return;
        lastFocused = trigger ?? document.activeElement;

        const dialog = document.createElement("div");
        overlay = dialog;
        dialog.setAttribute("role", "dialog");
        dialog.setAttribute("aria-modal", "true");
        dialog.setAttribute(
          "aria-label",
          alt ? `${previewLabel}: ${alt}` : previewLabel
        );
        dialog.className =
          "fixed inset-0 z-50 flex cursor-zoom-out items-center justify-center bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-200 motion-reduce:transition-none";

        const closeButton = document.createElement("button");
        closeButton.type = "button";
        closeButton.setAttribute("aria-label", closePreviewLabel);
        closeButton.className =
          "absolute end-4 top-4 rounded p-2 text-3xl leading-none text-white";
        closeButton.innerHTML = "&#10005;";
        closeButton.addEventListener("click", close);

        const image = document.createElement("img");
        image.src = src;
        image.alt = "";
        image.className =
          "max-h-[90dvh] max-w-[90dvw] cursor-default object-contain";

        dialog.append(closeButton, image);
        dialog.addEventListener("click", e => {
          if (e.target === dialog && currentScale <= 1) close();
        });

        let currentScale = 1;
        let translateX = 0;
        let translateY = 0;
        let initialDist = 0;
        let initialScale = 1;
        let panStartX = 0;
        let panStartY = 0;
        let panStartTranslateX = 0;
        let panStartTranslateY = 0;
        let lastTapTime = 0;

        function applyTransform() {
          image.style.transform = `scale(${currentScale}) translate(${translateX}px, ${translateY}px)`;
        }

        function resetTransform() {
          currentScale = 1;
          translateX = 0;
          translateY = 0;
          image.style.transform = "";
        }

        dialog.addEventListener(
          "touchstart",
          e => {
            const t = e.touches;
            if (t.length === 2) {
              initialDist = Math.hypot(
                t[1].clientX - t[0].clientX,
                t[1].clientY - t[0].clientY
              );
              initialScale = currentScale;
            } else if (t.length === 1) {
              const now = Date.now();
              if (now - lastTapTime < 300) {
                e.preventDefault();
                if (currentScale > 1) {
                  resetTransform();
                } else {
                  currentScale = 2;
                  translateX = 0;
                  translateY = 0;
                  applyTransform();
                }
                lastTapTime = 0;
                panStartX = t[0].clientX;
                panStartY = t[0].clientY;
                panStartTranslateX = translateX;
                panStartTranslateY = translateY;
              } else {
                lastTapTime = now;
                if (currentScale > 1) {
                  panStartX = t[0].clientX;
                  panStartY = t[0].clientY;
                  panStartTranslateX = translateX;
                  panStartTranslateY = translateY;
                }
              }
            }
          },
          { passive: false }
        );

        dialog.addEventListener(
          "touchmove",
          e => {
            const t = e.touches;
            if (t.length === 2) {
              e.preventDefault();
              const dist = Math.hypot(
                t[1].clientX - t[0].clientX,
                t[1].clientY - t[0].clientY
              );
              currentScale = Math.min(
                4,
                Math.max(1, initialScale * (dist / initialDist))
              );
              applyTransform();
            } else if (t.length === 1) {
              if (currentScale > 1) {
                e.preventDefault();
                translateX =
                  panStartTranslateX +
                  (t[0].clientX - panStartX) / currentScale;
                translateY =
                  panStartTranslateY +
                  (t[0].clientY - panStartY) / currentScale;
                const maxX = Math.max(
                  0,
                  (image.clientWidth - dialog.clientWidth / currentScale) / 2
                );
                const maxY = Math.max(
                  0,
                  (image.clientHeight - dialog.clientHeight / currentScale) / 2
                );
                translateX = Math.min(maxX, Math.max(-maxX, translateX));
                translateY = Math.min(maxY, Math.max(-maxY, translateY));
                applyTransform();
              } else {
                e.preventDefault();
              }
            }
          },
          { passive: false }
        );

        dialog.addEventListener("touchend", e => {
          if (e.touches.length === 0 && currentScale <= 1.05) {
            resetTransform();
          }
        });

        dialog.addEventListener("touchcancel", e => {
          if (e.touches.length === 0 && currentScale <= 1.05) {
            resetTransform();
          }
        });

        document.body.appendChild(dialog);
        document.body.style.overflow = "hidden";
        document.addEventListener("keydown", onKeyDown);

        requestAnimationFrame(() => dialog.classList.add("opacity-100"));
        closeButton.focus();
      }

      function close() {
        if (!overlay) return;
        const el = overlay;
        overlay = null;

        document.removeEventListener("keydown", onKeyDown);
        document.body.style.overflow = "";
        if (lastFocused instanceof HTMLElement) lastFocused.focus();
        lastFocused = null;

        if (prefersReducedMotion()) {
          el.remove();
          return;
        }
        const remove = () => el.remove();
        el.addEventListener("transitionend", remove, { once: true });
        setTimeout(remove, 250); // fallback in case transitionend never fires
        el.classList.remove("opacity-100");
      }

      function onKeyDown(e: KeyboardEvent) {
        if (e.key === "Escape") {
          close();
        } else if (e.key === "Tab") {
          trapFocus(e);
        }
      }

      // Keep keyboard focus inside the open dialog.
      function trapFocus(e: KeyboardEvent) {
        if (!overlay) return;
        const focusables = overlay.querySelectorAll<HTMLElement>(
          'a[href], button, [tabindex]:not([tabindex="-1"])'
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }

      function triggerFromEvent(e: Event): HTMLImageElement | null {
        const target = e.target;
        if (!(target instanceof Element)) return null;
        const image = target.closest("img");
        if (
          !(image instanceof HTMLImageElement) ||
          !article?.contains(image) ||
          image.closest("a")
        ) {
          return null;
        }
        return image;
      }

      function activate(image: HTMLImageElement) {
        open(image.currentSrc || image.src, image.alt, image);
      }

      article.addEventListener("click", e => {
        const image = triggerFromEvent(e);
        if (!image) return;
        e.preventDefault();
        activate(image);
      });

      article.addEventListener("keydown", e => {
        if (e.key !== "Enter" && e.key !== " " && e.key !== "Spacebar") return;
        const image = triggerFromEvent(e);
        if (!image) return;
        e.preventDefault();
        activate(image);
      });
    }
    initLightbox();
  </script>
</PostLayout>
