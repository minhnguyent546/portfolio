---
/**
 * One topic's slice of the ledger.
 *
 * `topic/` is a reserved segment under `/blog/`: a static path outranks the
 * `[...slug]` rest param, so a post folder named `topic` would be unreachable.
 */
import { getCollection } from "astro:content";
import BlogNav from "@/components/BlogNav.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import PostLedger from "@/components/PostLedger.astro";
import config from "@/config";
import { TOPIC_LABELS } from "@/data/topics";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getLedgerPosts, getTopicCounts } from "@/utils/getLedgerPosts";

export async function getStaticPaths() {
  const posts = getLedgerPosts(await getCollection("blog"));
  const counts = getTopicCounts(posts);

  // Only populated topics get a page; an empty one 404s instead of serving
  // a heading over nothing.
  return [...counts.keys()].map(topic => ({
    params: { topic },
    props: {
      topic,
      posts: posts.filter(post => post.data.topic === topic),
      counts,
      total: posts.length,
    },
  }));
}

const { topic, posts, counts, total } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const label = TOPIC_LABELS[topic];
---

<Layout
  title={`${t.pages.topicTitle}: ${label} | ${config.site.title}`}
  description={`Posts on ${label}.`}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={`${t.pages.topicTitle}: ${label}`}>
    <BlogNav {counts} {total} current={topic} />

    <PostLedger {posts} showTopic={false} />
  </Main>

  <Footer />
</Layout>
