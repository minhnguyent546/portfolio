---
import { getCollection } from "astro:content";
import BlogNav from "@/components/BlogNav.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import PostLedger from "@/components/PostLedger.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getLedgerPosts, getTopicCounts } from "@/utils/getLedgerPosts";

const posts = getLedgerPosts(await getCollection("blog"));
const counts = getTopicCounts(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.blogTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.blogTitle}>
    <BlogNav {counts} total={posts.length} />

    <PostLedger {posts} />
  </Main>

  <Footer />
</Layout>
