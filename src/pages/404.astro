---
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// The easter eggs, which no link on the site points to. Listed here rather than
// imported from the sitemap filter in astro.config.ts, which a page cannot
// import. Rendered server-side as the first entry so the hint still names a
// real route without JavaScript; the script below re-picks on every load.
const hiddenRoutes = ["/tty3", "/photon-sphere"];
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true"> ¯\_(ツ)_/¯ </span>
      <p class="mt-4 text-2xl sm:text-3xl">{t.notFound.message}</p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        {t.notFound.goHome}
      </LinkButton>

      <p
        class="mt-4 border-t border-rule pt-6 text-center text-meta text-ink-muted"
      >
        {t.notFound.hint}{" "}
        <a
          id="hidden-route"
          href={hiddenRoutes[0]}
          class="font-mono underline decoration-dotted underline-offset-4 hover:text-accent"
          >{hiddenRoutes[0]}</a
        >
      </p>
    </div>
  </main>

  <Footer />

  {
    /*
      Which egg the hint names is chosen per page load. The site is static, so
      the server cannot vary it and this is the only place the near-zero-JS rule
      bends: inline, no bundle, no request. The routes come from the server
      render above rather than a second literal, so the two cannot drift.
    */
  }
  <script is:inline define:vars={{ hiddenRoutes }}>
    (function () {
      const link = document.getElementById("hidden-route");
      const pick =
        hiddenRoutes[Math.floor(Math.random() * hiddenRoutes.length)];
      link.href = pick;
      link.textContent = pick;
    })();
  </script>
</Layout>
