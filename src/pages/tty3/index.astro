---
/**
 * tty3 — a shell over the site's own content. The boot log on `/` is tty1 and
 * its login prompt is tty2, so the shell a visitor reaches from there is tty3.
 *
 * The filesystem is built here and shipped as JSON. The shell script is
 * bundled and cannot read frontmatter, which is why the payload travels in the
 * document rather than as a module import.
 */
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import pkg from "../../../package.json";
import { buildFs } from "./_utils/buildFs";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) =>
  a.data.order - b.data.order;
const published = ({ data }: { data: { draft: boolean } }) => !data.draft;

const fs = buildFs({
  publications: (await getCollection("publications", published)).sort(byOrder),
  competitions: (await getCollection("competitions", published)).sort(byOrder),
  projects: (await getCollection("projects", published)).sort(byOrder),
  news: (await getCollection("news")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  ),
  articles: (await getCollection("articles")).sort(
    (a, b) => b.data.year - a.data.year
  ),
  about: await getEntry("pages", "about"),
  routes: {
    home: getRelativeLocaleUrl(locale, ""),
    about: getRelativeLocaleUrl(locale, "about"),
    blog: getRelativeLocaleUrl(locale, "blog"),
    tags: getRelativeLocaleUrl(locale, "tags"),
    search: getRelativeLocaleUrl(locale, "search"),
  },
});

const homeUrl = getRelativeLocaleUrl(locale, "");
const aboutUrl = getRelativeLocaleUrl(locale, "about");
---

{
  /* The panel scrolls its own scrollback, so the page behind it must not
     scroll too. `min-h-svh` on <body> leaves the height indefinite, which lets
     the panel grow the document and push the prompt out of view instead. */
}
<Layout
  title={`tty3 | ${config.site.title}`}
  description="A simulated terminal over the contents of this site."
  class="h-svh overflow-hidden"
>
  <Header />

  <main id="main-content" class="app-layout flex min-h-0 flex-1 flex-col py-6">
    <div
      id="tty"
      class="flex min-h-0 flex-1 flex-col border border-rule bg-paper-alt"
      data-home={homeUrl}
      data-user="visitor"
      data-release={`${pkg.version}-minhnguyent546`}
    >
      <div id="tty-out" role="log" aria-live="polite" tabindex="0"></div>
      <p id="tty-line">
        <span id="tty-prompt" aria-hidden="true"></span>
        <label class="sr-only" for="tty-input">{t.a11y.terminalInput}</label>
        <input
          id="tty-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          disabled
        />
      </p>
    </div>

    <noscript>
      <p class="mt-4">
        This page is a simulated terminal and needs JavaScript. The same content
        is on the <a href={homeUrl}>home page</a> and the
        <a href={aboutUrl}>about page</a>.
      </p>
    </noscript>
  </main>

  <Footer />

  {
    /* Parsed on demand by the shell. `<` is escaped so no file body can close
      this tag early. */
  }
  <script
    type="application/json"
    id="tty-fs"
    is:inline
    set:html={JSON.stringify(fs).replace(/</g, "\\u003c")}
  />
</Layout>

<style>
  #tty {
    /* 16px flat, not the fluid boot-log scale: a smaller input font makes iOS
       zoom on focus, and a monospace block with two sizes looks broken. */
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.6;
  }

  #tty:focus-within {
    outline: 2px dashed var(--accent);
    outline-offset: 1px;
  }

  /* A flex item defaults to min-height:auto and refuses to shrink, so without
     this the scrollback grows past the panel instead of scrolling inside it. */
  #tty-out {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* A line div with no text collapses to zero height, which would swallow the
     blank lines that separate a file's header from its body. */
  #tty-out :global(div:empty)::after {
    content: "\00a0";
  }

  #tty-line {
    display: flex;
    gap: 0.5ch;
    padding: 0 0.75rem 0.75rem;
  }

  #tty-prompt {
    flex: none;
    color: var(--ink-ok);
    white-space: pre;
  }

  #tty-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    caret-color: var(--accent);
  }

  /* The panel already shows focus, and a second ring inside it reads as an
     error state rather than as focus. */
  #tty-input:focus {
    outline: none;
  }

  #tty-out :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #tty-out :global(.tty-warn) {
    color: var(--ink-warn);
  }

  #tty-out :global(.tty-ok) {
    color: var(--ink-ok);
  }

  #tty-out :global(.tty-muted) {
    color: var(--ink-muted);
  }
</style>

<script>
  import "@/scripts/tty";
</script>
