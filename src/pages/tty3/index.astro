---
/**
 * tty3 — a shell over the site's own content. The boot log on `/` is tty1 and
 * its login prompt is tty2, so the shell a visitor reaches from there is tty3.
 *
 * The filesystem is built here and shipped as JSON. The shell script is
 * bundled and cannot read frontmatter, which is why the payload travels in the
 * document rather than as a module import.
 */
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import pkg from "../../../package.json";
import { buildFs } from "./_utils/buildFs";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) =>
  a.data.order - b.data.order;
const published = ({ data }: { data: { draft: boolean } }) => !data.draft;

const fs = buildFs({
  publications: (await getCollection("publications", published)).sort(byOrder),
  competitions: (await getCollection("competitions", published)).sort(byOrder),
  projects: (await getCollection("projects", published)).sort(byOrder),
  news: (await getCollection("news")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  ),
  articles: (await getCollection("articles")).sort(
    (a, b) => b.data.year - a.data.year
  ),
  about: await getEntry("pages", "about"),
  routes: {
    home: getRelativeLocaleUrl(locale, ""),
    about: getRelativeLocaleUrl(locale, "about"),
    blog: getRelativeLocaleUrl(locale, "blog"),
    tags: getRelativeLocaleUrl(locale, "tags"),
    search: getRelativeLocaleUrl(locale, "search"),
    photon: getRelativeLocaleUrl(locale, "photon-sphere"),
  },
});

const homeUrl = getRelativeLocaleUrl(locale, "");
const aboutUrl = getRelativeLocaleUrl(locale, "about");
---

{
  /* The panel scrolls its own scrollback, so the page behind it must not
     scroll too. `min-h-svh` on <body> leaves the height indefinite, which lets
     the panel grow the document and push the prompt out of view instead.

     `dvh`, not `svh`: `svh` is the viewport with the mobile browser bars shown,
     so once they retract the page is shorter than the space available and the
     footer leaves scrollable dead ground under it. `dvh` tracks the bars. */
}
<Layout
  title={`tty3 | ${config.site.title}`}
  description="A simulated terminal over the contents of this site."
  class="h-dvh overflow-hidden"
>
  <Header />

  <main id="main-content" class="app-layout flex min-h-0 flex-1 flex-col py-6">
    <div
      id="tty"
      class="min-h-0 flex-1 border border-rule bg-paper-alt"
      data-home={homeUrl}
      data-user="visitor"
      data-release={`${pkg.version}-minhnguyent546`}
    >
      <div id="tty-out" role="log" aria-live="polite" tabindex="0"></div>
      <p id="tty-line">
        <span id="tty-prompt" aria-hidden="true"></span>
        <label class="sr-only" for="tty-input">{t.a11y.terminalInput}</label>
        <input
          id="tty-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          disabled
        />
      </p>
    </div>

    <noscript>
      <p class="mt-4">
        This page is a simulated terminal and needs JavaScript. The same content
        is on the <a href={homeUrl}>home page</a> and the
        <a href={aboutUrl}>about page</a>.
      </p>
    </noscript>
  </main>

  <Footer />

  {
    /* Parsed on demand by the shell. `<` is escaped so no file body can close
      this tag early. */
  }
  <script
    type="application/json"
    id="tty-fs"
    is:inline
    set:html={JSON.stringify(fs).replace(/</g, "\\u003c")}
  />
</Layout>

<style>
  /* <body> is clipped, but the root is still the scroll container and takes its
     height from the document. Without this the page can scroll past the footer
     into empty space that the clipped body no longer fills. */
  :global(html:has(#tty)) {
    height: 100%;
    overflow: hidden;
  }

  #tty {
    /* Smaller than the 1rem body text: a terminal earns its density, and the
       panel is a fixed height, so every step down is another line of output. */
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  /* A touch device zooms when it focuses an input under 16px, and the panel is
     narrow enough there that the density would not buy much anyway. Sizing the
     panel rather than the input keeps the block at one size. */
  @media (pointer: coarse) {
    #tty {
      font-size: 1rem;
    }
  }

  #tty:focus-within {
    outline: 2px dashed var(--accent);
    outline-offset: 1px;
  }

  /* The panel scrolls, not the scrollback inside it. If the scrollback were the
     scroll container it would have to fill the panel to be scrollable, which
     pins the prompt to the bottom edge with blank space above it. Scrolling the
     panel instead lets the prompt sit right under the last line, the way a tty
     leaves the cursor where the output stopped. */
  #tty {
    overflow-y: auto;
    padding: 0.75rem;
  }

  #tty-out {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* A line div with no text collapses to zero height, which would swallow the
     blank lines that separate a file's header from its body. */
  #tty-out :global(div:empty)::after {
    content: "\00a0";
  }

  #tty-line {
    display: flex;
    gap: 0.5ch;
  }

  #tty-prompt {
    flex: none;
    color: var(--ink-ok);
    white-space: pre;
  }

  #tty-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    caret-color: var(--accent);
  }

  /* The panel already shows focus, and a second ring inside it reads as an
     error state rather than as focus. */
  #tty-input:focus {
    outline: none;
  }

  #tty-out :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #tty-out :global(.tty-warn) {
    color: var(--ink-warn);
  }

  #tty-out :global(.tty-ok) {
    color: var(--ink-ok);
  }

  #tty-out :global(.tty-muted) {
    color: var(--ink-muted);
  }
</style>

<script>
  import "@/scripts/tty";
</script>
