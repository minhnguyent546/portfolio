---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import BackToTopButton from "@/components/BackToTopButton.astro";
import BootSequence from "@/components/BootSequence.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import CompetitionRow from "@/components/home/CompetitionRow.astro";
import Experience from "@/components/home/Experience.astro";
import ExternalLink from "@/components/home/ExternalLink.astro";
import Hero from "@/components/home/Hero.astro";
import ProjectRow from "@/components/home/ProjectRow.astro";
import PublicationRow from "@/components/home/PublicationRow.astro";
import Section from "@/components/home/Section.astro";
import PersonSchema from "@/components/PersonSchema.astro";
import config from "@/config";
import { awards } from "@/data/awards";
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/utils/formatDate";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { dedupeTranslations } from "@/utils/getTranslation";
import { getUniqueTags } from "@/utils/getUniqueTags";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) =>
  a.data.order - b.data.order;
const published = ({ data }: { data: { draft: boolean } }) => !data.draft;

const publications = (await getCollection("publications", published)).sort(
  byOrder
);
const competitions = (await getCollection("competitions", published)).sort(
  byOrder
);
const experience = (await getCollection("experience", published)).sort(byOrder);
const projects = (await getCollection("projects", published)).sort(byOrder);
const allNews = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const NEWS_VISIBLE = 5;
const recentNews = allNews.slice(0, NEWS_VISIBLE);
const olderNews = allNews.slice(NEWS_VISIBLE);

const posts = await getCollection("blog");
const sortedPosts = dedupeTranslations(getSortedPosts(posts));

// The hero renders the collection entry, so the prose has one home. tty3
// reads the same entry for `about.txt`.
const about = await getEntry("pages", "about");
if (!about) {
  throw new Error("Missing content entry: `about.md` in `src/content/pages/`");
}
const homepageDescription = about.data.description;
if (!homepageDescription) {
  throw new Error("Missing description in `src/content/pages/about.md`");
}
const { Content: AboutContent } = await render(about);

const navSections = [
  { id: "news", label: "News" },
  { id: "publications", label: "Publications" },
  { id: "experience", label: "Experience" },
  { id: "competitions", label: "Competitions" },
  { id: "projects", label: "Projects" },
];

const awardsByYear = new Map<number, string[]>();
for (const { year, title } of awards) {
  awardsByYear.set(year, [...(awardsByYear.get(year) ?? []), title]);
}
const awardYears = [...awardsByYear.keys()].sort((a, b) => b - a);

/** Entry ids for the boot log, in the order the real sections use. */
const bootUnits = async (name: "publications" | "competitions" | "projects") =>
  (await getCollection(name, ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order)
    .map(({ id }) => id);
---

<Layout class="app-wide" description={homepageDescription}>
  <PersonSchema slot="head" description={homepageDescription} />
  <BootSequence
    postCount={sortedPosts.length}
    tagCount={getUniqueTags(posts).length}
    publications={await bootUnits("publications")}
    competitions={await bootUnits("competitions")}
    projects={await bootUnits("projects")}
  />
  <Header sections={navSections} />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="pb-8"
  >
    <Hero>
      <AboutContent />
    </Hero>

    <Section id="news" title="News">
      <ol class="divide-y divide-rule/50">
        {
          recentNews.map(({ data: { date, text, links } }) => {
            const { label, datetime } = formatDate(date, "month-short");
            return (
              <li class="grid gap-x-6 gap-y-0.5 py-2 first:pt-0 last:pb-0 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline">
                <time
                  datetime={datetime}
                  class="text-meta text-ink-muted tabular-nums"
                >
                  {label}
                </time>
                <p class="max-w-[65ch] min-w-0 text-body leading-[1.6] text-ink">
                  {text}
                  {links.length > 0 && (
                    <span class="ms-2 inline-flex flex-wrap items-center gap-x-2.5 text-meta">
                      {links.map(({ label: linkLabel, url }) => (
                        <ExternalLink label={linkLabel} {url} />
                      ))}
                    </span>
                  )}
                </p>
              </li>
            );
          })
        }
      </ol>

      {
        olderNews.length > 0 && (
          <details class="group mt-3">
            <summary class="inline-flex cursor-pointer list-none items-center gap-1 py-1 text-meta text-accent underline decoration-rule underline-offset-4 select-none hover:decoration-current [&::-webkit-details-marker]:hidden">
              <IconChevronRight
                class="size-3.5 shrink-0 fill-none stroke-current transition-transform duration-(--dur-micro) group-open:rotate-90"
                aria-hidden="true"
              />
              <span class="group-open:hidden">
                Older news ({olderNews.length})
              </span>
              <span class="hidden group-open:inline">Hide older news</span>
            </summary>
            <ol class="mt-2 divide-y divide-rule/50 border-t border-rule/50 pt-2">
              {olderNews.map(({ data: { date, text, links } }) => {
                const { label, datetime } = formatDate(date, "month-short");
                return (
                  <li class="grid gap-x-6 gap-y-0.5 py-2 first:pt-0 last:pb-0 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline">
                    <time
                      datetime={datetime}
                      class="text-meta text-ink-muted tabular-nums"
                    >
                      {label}
                    </time>
                    <p class="max-w-[65ch] min-w-0 text-body leading-[1.6] text-ink">
                      {text}
                      {links.length > 0 && (
                        <span class="ms-2 inline-flex flex-wrap items-center gap-x-2.5 text-meta">
                          {links.map(({ label: linkLabel, url }) => (
                            <ExternalLink label={linkLabel} {url} />
                          ))}
                        </span>
                      )}
                    </p>
                  </li>
                );
              })}
            </ol>
          </details>
        )
      }
    </Section>

    <Section id="publications" title="Publications">
      <div class="divide-y divide-rule/70">
        {publications.map(entry => <PublicationRow {entry} />)}
      </div>
      <p class="mt-3 text-meta text-ink-muted">* Equal contribution.</p>
    </Section>

    <Section id="experience" title="Experience">
      <Experience entries={experience} />
    </Section>

    <Section id="competitions" title="Competitions">
      <div class="divide-y divide-rule/70">
        {competitions.map(entry => <CompetitionRow {entry} />)}
      </div>
    </Section>

    <Section id="projects" title="Projects">
      <div class="divide-y divide-rule/70">
        {projects.map(entry => <ProjectRow {entry} />)}
      </div>
    </Section>

    <Section id="education" title="Education & Honors">
      <div class="grid gap-x-6 gap-y-1 sm:grid-cols-[11rem_minmax(0,1fr)]">
        <p class="pt-0.5 text-meta font-medium text-ink-muted">Education</p>
        <div class="max-w-[65ch] min-w-0">
          <p class="text-body leading-snug text-ink-heading">
            <span class="font-semibold">
              Engineer's degree, Information Technology
            </span>
            <span class="text-ink-muted"> · </span>
            <span class="text-ink">Can Tho University</span>
          </p>
          <p class="mt-1 text-meta text-ink-muted tabular-nums">
            GPA 3.91/4.0 · TOEIC 845
          </p>
          <p class="mt-1 text-body leading-[1.6] text-ink">
            Thesis: <em>
              Building a Smart Enrollment Advisory System Based on an Automatic
              Dialogue Model
            </em>
            <span class="text-meta text-ink-muted"> · grade 9.6/10</span>
          </p>
        </div>
      </div>

      <ol class="mt-5 divide-y divide-rule/50 border-t border-rule/70 pt-4">
        {
          awardYears.map(year => (
            <li class="grid gap-x-6 gap-y-0.5 py-2 first:pt-0 last:pb-0 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-baseline">
              <span class="text-meta text-ink-muted tabular-nums">{year}</span>
              <div class="max-w-[65ch] min-w-0 space-y-1 text-body leading-[1.6] text-ink">
                {awardsByYear.get(year)!.map(title => (
                  <p>{title}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
    </Section>

    <BackToTopButton uiLocale={locale as "en" | "vi"} />
  </main>

  <Footer />
</Layout>

<script>
  const indexLayout = (document.querySelector("#main-content") as HTMLElement)
    ?.dataset;
  const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  if (indexLayout?.layout) {
    sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
  }
</script>
