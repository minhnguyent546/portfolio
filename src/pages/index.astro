---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconLinkedin from "@/assets/icons/socials/linkedin.svg";
import IconMail from "@/assets/icons/socials/mail.svg";
import IconX from "@/assets/icons/socials/x.svg";
import BootSequence from "@/components/BootSequence.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import CompetitionRow from "@/components/home/CompetitionRow.astro";
import Experience from "@/components/home/Experience.astro";
import Hero from "@/components/home/Hero.astro";
import LinkRow from "@/components/home/LinkRow.astro";
import ProjectRow from "@/components/home/ProjectRow.astro";
import PublicationRow from "@/components/home/PublicationRow.astro";
import Section from "@/components/home/Section.astro";
import SectionNav from "@/components/home/SectionNav.astro";
import PersonSchema from "@/components/PersonSchema.astro";
import config from "@/config";
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/utils/formatDate";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { dedupeTranslations } from "@/utils/getTranslation";
import { getUniqueTags } from "@/utils/getUniqueTags";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) =>
  a.data.order - b.data.order;
const published = ({ data }: { data: { draft: boolean } }) => !data.draft;

const publications = (await getCollection("publications", published)).sort(
  byOrder
);
const competitions = (await getCollection("competitions", published)).sort(
  byOrder
);
const experience = (await getCollection("experience", published)).sort(byOrder);
const projects = (await getCollection("projects", published)).sort(byOrder);

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.year - a.data.year
);

const posts = await getCollection("blog");
const sortedPosts = dedupeTranslations(getSortedPosts(posts));

// Section 01 renders the collection entry, so the prose has one home. tty3
// reads the same entry for `about.txt`.
const about = await getEntry("pages", "about");
if (!about) {
  throw new Error("Missing content entry: `about.md` in `src/content/pages/`");
}
const { Content: AboutContent } = await render(about);

const sections = [
  { id: "about", label: "About" },
  { id: "news", label: "News" },
  { id: "publications", label: "Publications" },
  { id: "competitions", label: "Competitions" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "writing", label: "Writing" },
  { id: "contact", label: "Contact" },
];

const socialUrl = (name: string) => socials.find(s => s.name === name)!.url;

const contactRows = [
  {
    Icon: IconMail,
    href: socialUrl("mail"),
    text: socialUrl("mail").replace("mailto:", ""),
    srSuffix: "",
    mono: true,
  },
  {
    Icon: IconX,
    href: socialUrl("x"),
    text: "DMs are open",
    srSuffix: " on X",
    mono: false,
  },
  {
    Icon: IconLinkedin,
    href: socialUrl("linkedin"),
    text: "Happy to connect",
    srSuffix: " on LinkedIn",
    mono: false,
  },
];

/** Entry ids for the boot log, in the order the real sections use. */ const bootUnits =
  async (name: "publications" | "competitions" | "projects") =>
    (await getCollection(name, ({ data }) => !data.draft))
      .sort((a, b) => a.data.order - b.data.order)
      .map(({ id }) => id);
---

<Layout class="app-wide">
  <PersonSchema slot="head" />
  <BootSequence
    postCount={sortedPosts.length}
    tagCount={getUniqueTags(posts).length}
    publications={await bootUnits("publications")}
    competitions={await bootUnits("competitions")}
    projects={await bootUnits("projects")}
  />
  <Header />
  <SectionNav items={sections} />

  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <Hero />

    <Section id="about" title="About">
      <div class="max-w-measure space-y-4">
        <AboutContent />
      </div>
    </Section>

    <Section id="news" title="News">
      <ol class="divide-y divide-rule border-y border-rule">
        {
          news.map(({ data: { date, text, links } }) => {
            const { label, datetime } = formatDate(date);
            return (
              <li class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-12">
                <time
                  datetime={datetime}
                  class="font-mono text-meta text-ink-muted tabular-nums sm:col-span-3"
                >
                  {label}
                </time>
                <div class="min-w-0 sm:col-span-9">
                  <p>{text}</p>
                  <LinkRow {links} class="mt-1" />
                </div>
              </li>
            );
          })
        }
      </ol>
    </Section>

    <Section
      id="publications"
      title="Publications"
      note="Preprints and journal papers. Author lists are as submitted."
    >
      <div class="divide-y divide-rule border-y border-rule">
        {publications.map(entry => <PublicationRow {entry} />)}
      </div>
      <p class="mt-3 text-meta text-ink-muted">* Equal contribution.</p>
    </Section>

    <Section id="competitions" title="Competitions">
      <div class="divide-y divide-rule border-y border-rule">
        {competitions.map(entry => <CompetitionRow {entry} />)}
      </div>
    </Section>

    <Section id="experience" title="Experience">
      <Experience entries={experience} />
    </Section>

    <Section
      id="projects"
      title="Projects"
      note="Each project explains one engineering decision and the result it produced."
    >
      <div class="divide-y divide-rule border-y border-rule">
        {projects.map(entry => <ProjectRow {entry} />)}
      </div>
    </Section>

    <Section id="writing" title="Writing">
      {
        sortedPosts.length > 0 && (
          <ol class="divide-y divide-rule border-y border-rule">
            {sortedPosts.slice(0, config.posts.perIndex).map(post => {
              const { label, datetime } = formatDate(post.data.pubDatetime);
              return (
                <li class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-12">
                  <time
                    datetime={datetime}
                    class="font-mono text-meta text-ink-muted tabular-nums sm:col-span-3"
                  >
                    {label}
                  </time>
                  <div class="min-w-0 sm:col-span-9">
                    <a
                      href={getPostUrl(post.id, post.filePath, locale)}
                      lang={post.data.lang}
                      class="inline-block py-1 text-accent underline decoration-rule underline-offset-4 hover:decoration-current"
                    >
                      {post.data.title}
                    </a>
                    <p lang={post.data.lang} class="text-ink-muted">
                      {post.data.description}
                    </p>
                  </div>
                </li>
              );
            })}
          </ol>
        )
      }

      <h3 class="mt-8 font-mono text-h3 text-ink-heading">VNOI Magazine</h3>
      <ol class="mt-3 divide-y divide-rule border-y border-rule">
        {
          articles.map(
            ({ data: { title, titleVi, publication, year, url } }) => (
              <li class="grid gap-x-6 gap-y-1 py-4 sm:grid-cols-12">
                <span class="font-mono text-meta text-ink-muted tabular-nums sm:col-span-3">
                  {year}
                </span>
                <div class="min-w-0 sm:col-span-9">
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block py-1 text-accent underline decoration-rule underline-offset-4 hover:decoration-current"
                  >
                    {title}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                  {titleVi && (
                    <p class="text-meta text-ink-muted" lang="vi">
                      {titleVi}
                    </p>
                  )}
                  <p class="mt-1 text-meta text-ink-muted">{publication}</p>
                </div>
              </li>
            )
          )
        }
      </ol>

      <p class="mt-5">
        <a
          href={getRelativeLocaleUrl(locale, "blog")}
          class="inline-block py-1 text-accent underline decoration-rule underline-offset-4 hover:decoration-current"
        >
          All posts →
        </a>
      </p>
    </Section>

    <Section id="contact" title="Contact">
      <ul class="flex flex-col gap-y-1">
        {
          contactRows.map(({ Icon, href, text, srSuffix, mono }) => {
            const isMail = href.startsWith("mailto:");
            return (
              <li>
                <a
                  href={href}
                  target={isMail ? undefined : "_blank"}
                  rel={isMail ? undefined : "noopener noreferrer"}
                  class="inline-flex items-center gap-2.5 py-1.5 text-accent underline decoration-rule underline-offset-4 hover:decoration-current"
                >
                  <Icon
                    class="size-5 shrink-0 no-underline"
                    aria-hidden="true"
                  />
                  <span class:list={[{ "font-mono": mono }]}>
                    {text}
                    <span class="sr-only">{srSuffix}</span>
                    {!isMail && <span aria-hidden="true"> ↗</span>}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </Section>
  </main>

  <Footer />
</Layout>

<script>
  const indexLayout = (document.querySelector("#main-content") as HTMLElement)
    ?.dataset;
  const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
  if (indexLayout?.layout) {
    sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
  }
</script>
